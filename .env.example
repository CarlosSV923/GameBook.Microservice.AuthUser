# Runtime database connection for the AuthUser schema.
AUTH_DATABASE_URL=

# RS256 signing and validation configuration.
JWT_PRIVATE_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# Optional exact browser origins, comma-separated.
