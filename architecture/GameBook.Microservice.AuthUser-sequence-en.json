  "cards": [
    {
      "dot": "rose",
      "title": "Revocation rule",
      "items": [
        "Login signs the current sessionVersion into JWT claim ver.",
        "Password change increments the aggregate version and persists only if the expected version still matches.",
        "Session validation compares the token version with persisted state; the old token then receives 401."
      ]
